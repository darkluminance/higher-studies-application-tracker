# Build stage
FROM golang:1.24-alpine AS builder

WORKDIR /app

# Install Air for hot reloading
RUN go install github.com/air-verse/air@v1.61.7
COPY go.mod go.sum ./

RUN go install github.com/pressly/goose/v3/cmd/goose@v3.22.1
COPY migrations/ ./migrations

RUN go mod download

COPY air.toml ./

EXPOSE 8080

CMD ["air"]